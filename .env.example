# API Keys (configure via stock-analyzer setup)
ALPHA_VANTAGE_API_KEY=your_key_here
FINNHUB_API_KEY=your_key_here

# Market Intelligence LLM correlator (M2-03)
# OpenAI-compatible endpoint. Defaults match a local LM Studio install.
# - For LM Studio on the same machine: http://localhost:1234/v1
# - For LM Studio on Windows host from WSL2: use the Windows host IP
#   (cat /etc/resolv.conf | grep nameserver) e.g. http://172.x.x.x:1234/v1
# - For remote: https://api.deepseek.com/v1, https://openrouter.ai/api/v1, etc.
LLM_ENDPOINT=http://localhost:1234/v1
LLM_MODEL=qwen/qwen3-14b
LLM_API_KEY=lm-studio

# Telegram (optional)
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# SendGrid (optional)
SENDGRID_API_KEY=your_key_here
SENDGRID_FROM_EMAIL=your_email_here
SENDGRID_TO_EMAIL=your_email_here

# Application
NODE_ENV=production
LOG_LEVEL=info
PORT=3000

# Paper Trading
PAPER_TRADING_ENABLED=true
PAPER_TRADING_INITIAL_CAPITAL=10000

# Risk Management
RISK_MAX_POSITION_SIZE_PERCENT=25
RISK_MAX_DAILY_LOSS_PERCENT=5
