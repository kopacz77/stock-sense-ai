{
  "name": "stock-sense-ai",
  "version": "1.0.0",
  "description": "Secure local stock analysis CLI with advanced trading strategies",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "stock-analyzer": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:frontend": "cd web/frontend && npm run build",
    "build:all": "pnpm build && pnpm build:frontend && mkdir -p web/public && cp -r web/frontend/dist/* web/public/",
    "dev": "tsx src/index.ts",
    "dev:backend": "tsx watch src/index.ts dashboard --port 3001",
    "dev:frontend": "cd web/frontend && npm run dev",
    "dev:all": "concurrently -n \"API,WEB\" -c \"blue,green\" \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "start": "node dist/index.js",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist",
    "prepare": "pnpm build"
  },
  "keywords": [
    "stock-analysis",
    "trading",
    "cli",
    "security",
    "technical-analysis",
    "mean-reversion",
    "momentum",
    "risk-management"
  ],
  "author": "Stock Sense AI",
  "license": "MIT",
  "dependencies": {
    "@sendgrid/mail": "^8.1.0",
    "@types/uuid": "^11.0.0",
    "axios": "^1.6.2",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "inquirer": "^9.2.12",
    "jsonwebtoken": "^9.0.3",
    "keytar": "^7.9.0",
    "node-cron": "^4.2.1",
    "openai": "^6.39.0",
    "ora": "^7.0.1",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.7.4",
    "technicalindicators": "^3.1.0",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/inquirer": "^9.0.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.9",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^1.6.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}